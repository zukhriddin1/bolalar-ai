# Absolute URL of the deployed API (no trailing slash).
# Leave this unset locally — the dev server proxies /api to http://localhost:4000
VITE_API_URL=https://bolalar-ai-api.onrender.com

# Google OAuth client ID (Web application) from https://console.cloud.google.com
# Leave unset to hide the "continue with Google" button entirely.
VITE_GOOGLE_CLIENT_ID=
