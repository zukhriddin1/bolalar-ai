# --- server ---
PORT=4000
DATABASE_PATH=./data/bolalar.db

# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d
CORS_ORIGIN=http://localhost:5173

# Optional. Without a key the app uses the built-in offline lesson generator,
# which is fully functional — arithmetic is computed, other topics come from a
# curated bank.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
